# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Decision engine ───────────────────────────────────────────────────────────
# "rules"   — deterministic, zero AWS dependency (default for local dev)
# "bedrock" — Claude via Amazon Bedrock, auto-falls back to rules on failure
DECISION_ENGINE=rules

# ── Store backend ─────────────────────────────────────────────────────────────
# "memory"   — in-process, seeded, lost on restart (default for local dev)
# "dynamo"   — DynamoDB (used by Lambda in production; requires AWS_REGION + table env vars)
# "postgres" — local Postgres via docker-compose (requires DATABASE_URL)
STORE_BACKEND=memory

# ── AWS (required when STORE_BACKEND=dynamo or DECISION_ENGINE=bedrock) ───────
AWS_REGION=us-east-1

# ── Bedrock (required when DECISION_ENGINE=bedrock) ───────────────────────────
# Must be enabled in your account/region via the Bedrock console → Model access
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# Milliseconds before a Bedrock call times out and falls back to the rule engine
BEDROCK_TIMEOUT_MS=4000

# ── DynamoDB table names (required when STORE_BACKEND=dynamo) ─────────────────
# Defaults match what template.yaml and infra/dynamodb-tables.sh create.
# Only set these if you used custom table names.
# TABLE_MEMBERS=guardian-members
# TABLE_VISITORS=guardian-visitors
# TABLE_POLICIES=guardian-policies
# TABLE_EVENTS=guardian-events
# TABLE_INCIDENTS=guardian-incidents
# TABLE_CONFIG=guardian-config

# ── Postgres (required when STORE_BACKEND=postgres) ───────────────────────────
# docker-compose.yml exposes Postgres on 25432 (not 5432) to avoid conflicts.
# DATABASE_URL=postgresql://guardian:guardian@localhost:25432/guardian

# ── Ring simulator ────────────────────────────────────────────────────────────
# Set to "true" to log events to stdout instead of sending to EventBridge.
# Required for local dev — remove or set to "false" once deployed.
RING_SIMULATOR_DRY_RUN=true
# EventBridge bus name — "default" works for the SAM-deployed stack.
# EVENT_BUS_NAME=default
